# ── Google Sheets integration (server-only — never prefix with NEXT_PUBLIC_) ──
# Web-app URL from Apps Script › Deploy › New deployment › Web app
SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/XXXXXXXXXXXX/exec
# Any long random string. Must match SECRET in scripts/google-apps-script/Code.gs
SHEETS_SHARED_SECRET=change-me-to-a-long-random-string

# ── Privacy ──
# Show student team names on project cards (false by default)
NEXT_PUBLIC_SHOW_STUDENT_NAMES=false

# ── Public site URL (used for sitemap, OpenGraph, JSON-LD) ──
NEXT_PUBLIC_SITE_URL=https://build.srisriuniversity.edu.in

# ── FET faculty coordinator shown in the footer & thank-you page (optional) ──
# Leave blank to use the values in src/data/team.ts
FET_COORDINATOR_NAME=
FET_COORDINATOR_EMAIL=
FET_COORDINATOR_PHONE=
